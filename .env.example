# Copy to .env and adjust. Values below match documented local defaults.

LISTEN_ADDR=:8080
# PORT=8080   # Cloud Run sets this; used when LISTEN_ADDR is empty
PUBLIC_BASE_URL=http://localhost:8080

AGENT_API_KEY=dev-agent-key
FEED_USERNAME=podcast
FEED_PASSWORD=podcast
FEED_TOKEN=dev-feed-token

STORE_BACKEND=sqlite
SQLITE_PATH=data/podcaster.db

STORAGE_BACKEND=local
LOCAL_DATA_DIR=data

JOB_BACKEND=local
TTS_ENGINE=mock
FFMPEG_BIN=ffmpeg
DEFAULT_VOICE=en_US-lessac-medium

PODCAST_TITLE=Private Agent Briefing
PODCAST_DESCRIPTION=Automated private briefings synthesized from agent updates.
PODCAST_AUTHOR=Podcaster
PODCAST_LANGUAGE=en-us
PODCAST_CATEGORY=Technology
PODCAST_EXPLICIT=false

# Production (GCP) — uncomment and fill in:
# STORE_BACKEND=firestore
# STORAGE_BACKEND=gcs
# JOB_BACKEND=cloudrun
# TTS_ENGINE=piper
# GCP_PROJECT=your-project
# GCS_BUCKET=your-audio-bucket
# CLOUD_RUN_JOB=podcaster-worker
# CLOUD_RUN_REGION=us-central1
# PIPER_BIN=/opt/piper/piper
# PIPER_MODEL=/opt/piper/voices/en_US-lessac-medium.onnx
# PIPER_CONFIG=/opt/piper/voices/en_US-lessac-medium.onnx.json
# PUBLIC_BASE_URL=https://your-service.run.app
