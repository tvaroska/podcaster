# Checklist of process environment variables.
# The binary does NOT load this file. To use it locally:
#   set -a && source .env && set +a && ./bin/server
# `make run` ignores .env and injects local defaults itself.

LISTEN_ADDR=:8080
# PORT=8080   # Cloud Run sets this; used when LISTEN_ADDR is empty
PUBLIC_BASE_URL=http://localhost:8080

# Auth: When ADMIN_API_KEY is set, it is the super key required to create/list users
# (POST /v1/podcasts, GET /v1/podcasts), while AGENT_API_KEY is scoped to submitting to
# the default feed. When ADMIN_API_KEY is unset, AGENT_API_KEY acts as the super key.
ADMIN_API_KEY=
AGENT_API_KEY=dev-agent-key
# Default show only. Per-user shows get their own credentials from POST /v1/podcasts.
FEED_USERNAME=podcast
FEED_PASSWORD=podcast
FEED_TOKEN=dev-feed-token

STORE_BACKEND=sqlite
SQLITE_PATH=data/podcaster.db

STORAGE_BACKEND=local
LOCAL_DATA_DIR=data

JOB_BACKEND=local
WORKER_TIMEOUT=30m
SHUTDOWN_TIMEOUT=25s
TTS_ENGINE=mock
FFMPEG_BIN=ffmpeg
DEFAULT_VOICE=af_heart
# VOICE_ALLOWLIST=af_heart,af_bella,am_adam,am_fenrir,am_michael,bf_emma,bm_george

PODCAST_TITLE=Private Agent Briefing
PODCAST_DESCRIPTION=Automated private briefings synthesized from agent updates.
PODCAST_AUTHOR=Podcaster
PODCAST_LANGUAGE=en-us
PODCAST_CATEGORY=Technology
PODCAST_EXPLICIT=false
# PODCAST_IMAGE_FILE=
# PODCAST_OWNER_EMAIL=

MIN_CONTENT_LENGTH=10
MAX_CONTENT_LENGTH=100000
MAX_TITLE_LENGTH=200
# PODCASTER_DEV=1

# Production (GCP) — set these on the Cloud Run Service / Job, not in a checked-in file.
# STORE_BACKEND=firestore
# STORAGE_BACKEND=gcs
# JOB_BACKEND=cloudrun          # service only; the Job must keep JOB_BACKEND=local
# TTS_ENGINE=kokoro             # Job image; service should stay mock
# GCP_PROJECT=your-project
# GCS_BUCKET=your-audio-bucket
# CLOUD_RUN_JOB_NAME=podcaster-worker   # do not set CLOUD_RUN_JOB on a Cloud Run Service
# CLOUD_RUN_REGION=us-central1
# KOKORO_BIN=/opt/sherpa-onnx/bin/sherpa-onnx-offline-tts   # already set in the worker image
# KOKORO_MODEL_DIR=/opt/kokoro/kokoro-multi-lang-v1_0
# KOKORO_DICT_DIR=/opt/kokoro/kokoro-multi-lang-v1_0/dict
# KOKORO_SPEED=0.95
# KOKORO_THREADS=2
# KOKORO_CONCURRENCY=1          # parallel TTS chunks; size so KOKORO_CONCURRENCY * KOKORO_THREADS <= Job vCPUs
# PUBLIC_BASE_URL=https://your-service.run.app
